<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Shapez2MultiplayerMod</AssemblyName>
    <RootNamespace>Shapez2MultiplayerMod</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Shapez2 Multiplayer Team</Authors>
    <Description>Multiplayer mod for Shapez 2 using BepInEx modding framework</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Environment variables for game paths -->
    <SPZ2_PATH Condition="'$(SPZ2_PATH)' == ''">C:\Program Files (x86)\Steam\steamapps\common\shapez 2</SPZ2_PATH>
    <SPZ2_PERSISTENT Condition="'$(SPZ2_PERSISTENT)' == ''">$(APPDATA)\..\LocalLow\tobspr\shapez 2</SPZ2_PERSISTENT>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity assemblies -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPZ2_PATH)\shapez 2_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SPZ2_PATH)\shapez 2_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SPZ2_PATH)\shapez 2_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SPZ2_PATH)\shapez 2_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- Game assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SPZ2_PATH)\shapez 2_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- BepInEx assemblies - These will be in the BepInEx folder after installation -->
    <Reference Include="BepInEx">
      <HintPath>$(SPZ2_PATH)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet packages -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- Copy the built DLL to BepInEx plugins folder -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SPZ2_PATH)\BepInEx\plugins\" />
    <Message Text="Mod copied to: $(SPZ2_PATH)\BepInEx\plugins\$(TargetFileName)" Importance="high" />
  </Target>

</Project>

